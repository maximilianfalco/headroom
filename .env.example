# Copy to .env and edit. No secrets live here, only per-machine build settings.
# The OAuth token is read from the keychain at runtime and is never stored.

# Values are sourced by build.sh, so quote anything containing spaces.

# The app's bundle identifier. The widget and tests hang off it.
BUNDLE_ID="app.example"

# Name of the code signing certificate in your login keychain.
# See README > Signing identity for how to create one.
SIGNING_IDENTITY="Headroom Local"
